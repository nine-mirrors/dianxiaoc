# 复制本文件为 .env 并填写后重启后端，即可启用真 LLM：
#   cp .env.example .env  →  填 key  →  npm start

# ═══════════ 鉴权签名密钥（务必配置，缺省则重启即登出） ═══════════
# 用于 HMAC-SHA256 签发会话 token（防伪造、可过期）。生成方式：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ⚠ 不配置时后端会退化为进程级随机密钥并打印警告，重启后所有 token 立即失效。
AUTH_SECRET=sk-xxx

# ═══════════ 主推方案：全部用通义千问（一个平台、一个 key） ═══════════
# 申请：https://dashscope.console.aliyun.com 开通「百炼」→ API-KEY 创建，新用户送免费额度
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus              # 文本：qwen-plus 均衡 / qwen-turbo 更快 / qwen-max 最强

LLM_VL_API_KEY=sk-xxx
LLM_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VL_MODEL=qwen-vl-plus        # 视觉：货架识别

# ═══════════ 备选：文本用 DeepSeek，视觉仍用千问 ═══════════
# 想省文本成本可把上面 LLM 三项换成：
#   LLM_API_KEY=sk-你的deepseek_key
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#（视觉那三项保持千问不变）

# ═══════════ 其他备选视觉模型 ═══════════
# 智谱 GLM-4V：   LLM_VL_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_VL_MODEL=glm-4v-plus
# 腾讯混元 vision：LLM_VL_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1  LLM_VL_MODEL=hunyuan-turbos-vision
