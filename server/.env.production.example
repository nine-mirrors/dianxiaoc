# ═══════════════════════════════════════════════════════════════
# 店小C 后端 · 公网/生产环境变量模板
# 用法：cp .env.production.example .env  然后逐项填写
# 该文件只在服务器上存在，已被 .gitignore 忽略，不要提交真实密钥。
# ═══════════════════════════════════════════════════════════════

# 生产模式开关：置为 production 后
#   ① GET /api/v1/auth/demo-accounts 返回 404（不再下发明文口令）；
#   ② 登录与 AI/视觉接口启用限流。
NODE_ENV=production

# 监听地址：保持回环！公网入口由同机 Nginx 反代，绝不直接暴露 3000。
HOST=127.0.0.1
PORT=3000

# 会话签名密钥（必填，固定值，否则重启后所有人掉登录）。
# 在服务器上生成： node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=请替换为64位随机十六进制

# 大模型（通义千问，一个 key 即可同时供文本与视觉）
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_VL_API_KEY=sk-你的key
LLM_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VL_MODEL=qwen-vl-plus

# CORS：同域部署其实用不到跨域；如需单独域名前端，填前端完整来源（逗号分隔）。
# VITE_ORIGIN=https://你的域名

# 缓存：不配 REDIS_URL 时使用内置 RESP 兼容服务，单机演示无需改动。
# REDIS_URL=
